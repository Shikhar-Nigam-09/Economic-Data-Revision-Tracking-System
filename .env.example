# ==============================================================================
# Economic Data Monitoring and Revision Tracking System - Environment Template
# Copy this file to .env and replace placeholders with your actual configuration.
# DO NOT commit .env containing real credentials to version control.
# ==============================================================================

# Database Configuration (PostgreSQL 15+ with psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/econ_monitor
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/econ_monitor_test

# Federal Reserve Economic Data (FRED / ALFRED) API Key
# Obtain a free key from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Telegram Bot Notifications (Optional for Phase 1)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# FastAPI Application Service
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Event Dispatcher & System Tuning
NOTIFY_MAX_EVENT_AGE_DAYS=30
LOG_LEVEL=INFO
